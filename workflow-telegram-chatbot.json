    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "if _item[\"json\"][\"cod\"] == \"404\" or _item[\"json\"][\"cod\"] == 404:\n    return {\n        'codigo': str(_item[\"json\"][\"cod\"]),\n        'mensagem': 'cidade_nao_encontrada'\n    }\n\nif _item[\"json\"][\"cod\"] == \"401\" or _item[\"json\"][\"cod\"] == 401:\n    return {\n        'codigo': str(_item[\"json\"][\"cod\"]),\n        'mensagem': 'erro_autenticacao'\n    }\n\ntemp = _item[\"json\"][\"main\"][\"temp\"]\ntemperatura = int(temp + 0.5) if temp >= 0 else int(temp - 0.5)\n\nreturn {\n    'temperatura': temperatura,\n    'cidade': _item[\"json\"][\"name\"],\n    'codigo': str(_item[\"json\"][\"cod\"]),\n    'pais': _item[\"json\"][\"sys\"][\"country\"],\n    'mensagem': 'sucesso'\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3792,
        -96
      ],
      "id": "75fef227-7c57-4c06-8917-536a41dbda84",
      "name": "Tratar Dados"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "# 1. Recupera o texto original do Telegram\ntexto_original = _item[\"json\"][\"message\"][\"text\"]\n\n# 2. Remove espaços sobrando e converte para letras minúsculas\ntexto_limpo = texto_original.strip().lower()\n\n# 3. Dicionários de mapeamento para remoção de acentos (Python Puro)\ncom_acentos = \"áàãâäéèêëíìîïóòõôöúùûüç\"\nsem_acentos = \"aaaaaeeeeiiiiooooouuuuc\"\n\n# 4. Loop de substituição: troca cada letra acentuada pela sua versão limpa\ntexto_sem_acento = texto_limpo\nfor i in range(len(com_acentos)):\n    texto_sem_acento = texto_sem_acento.replace(com_acentos[i], sem_acentos[i])\n\n# 5. Tratamento de formatação \"Cidade/Estado\" (ex: \"sao paulo/sp\" -> \"sao paulo\")\ncidade_final = texto_sem_acento.split(',')[0]\n\n# 6. Retorna a saída estruturada para o n8n\nreturn {\n  \"queue\": cidade_final\n}\n"
      },
