    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "# 1. Recupera o texto original do Telegram\ntexto_original = _item[\"json\"][\"message\"][\"text\"]\n\n# 2. Remove espaços sobrando e converte para letras minúsculas\ntexto_limpo = texto_original.strip().lower()\n\n# 3. Dicionários de mapeamento para remoção de acentos (Python Puro)\ncom_acentos = \"áàãâäéèêëíìîïóòõôöúùûüç\"\nsem_acentos = \"aaaaaeeeeiiiiooooouuuuc\"\n\n# 4. Loop de substituição: troca cada letra acentuada pela sua versão limpa\ntexto_sem_acento = texto_limpo\nfor i in range(len(com_acentos)):\n    texto_sem_acento = texto_sem_acento.replace(com_acentos[i], sem_acentos[i])\n\n# 5. Tratamento de formatação \"Cidade/Estado\" (ex: \"sao paulo/sp\" -> \"sao paulo\")\ncidade_final = texto_sem_acento.split('/')[0].strip()\n\ntry:\n    estado_final = f\", {texto_sem_acento.split('/')[1].strip()}\"\nexcept:\n    estado_final = \"\"\n\n# 6. Retorna a saída estruturada para o n8n\nreturn {\n  \"queue\": f\"{cidade_final}{estado_final}\"\n}\n"
      },
